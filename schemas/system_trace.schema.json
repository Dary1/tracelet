{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracelet.app/schemas/system_trace.schema.json",
  "title": "Tracelet System Trace",
  "description": "Schema for assets/system_traces/*.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "coordinateSpace", "fadeDurationMs", "strokes"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9]*$",
      "description": "Must match the filename without .json and a SystemTraceId enum value."
    },
    "kind": {
      "type": "string",
      "const": "system"
    },
    "coordinateSpace": {
      "type": "string",
      "enum": ["normalized"]
    },
    "fadeDurationMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30000
    },
    "strokes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stroke" }
    }
  },
  "$defs": {
    "stroke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points"],
      "properties": {
        "color": {
          "type": "string",
          "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "points": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/point" }
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "t": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
